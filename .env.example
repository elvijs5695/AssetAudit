# Netlify > Environment variables (never commit actual values).
# Public build settings (only URL and publishable key end up in dist/config.js):
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only: restrict to Functions scope, NEVER browser or source control.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback env names: SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
