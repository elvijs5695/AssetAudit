# Set in Netlify Site configuration > Environment variables.
# Supabase URL / anon key are PUBLIC (and deliberately embedded in static config.js)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=PUBLIC_ANON_OR_PUBLISHABLE_KEY
# This secret must only be available in Netlify Functions scope, never a VITE_/public setting.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET_KEY
